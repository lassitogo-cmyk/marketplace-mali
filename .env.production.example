# ============================================================
#  Marketplace Mali — configuration de PRODUCTION (Render + Neon)
#  À recopier dans Render → Environment (ne pas commiter de secret).
# ============================================================

APP_NAME="Marketplace Mali"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
# ↑ Générez la vôtre une seule fois : php artisan key:generate --show
#   puis collez-la dans Render → Environment. Ne jamais publier cette clé.
APP_URL=https://marketplace-mali.onrender.com
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Neon.tech → chaîne de connexion PostgreSQL (avec ?sslmode=require)
DB_CONNECTION=pgsql
DB_URL=postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE/neondb?sslmode=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

BCRYPT_ROUNDS=12

# Durée de vie des jetons de connexion : 30 jours
SANCTUM_EXPIRATION=43200

# ---------- E-mails (notifications de commande) ----------
# Option A — Gmail (mot de passe d'application) :
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=moncompte@gmail.com
#   MAIL_PASSWORD=mot_de_passe_application_16_caracteres
#   MAIL_ENCRYPTION=tls
# Option B — Brevo (gratuit 300 e-mails/jour) :
#   MAIL_MAILER=smtp / MAIL_HOST=smtp-relay.brevo.com / MAIL_PORT=587
# Sans identifiants : MAIL_MAILER=log (les e-mails vont dans les journaux).
MAIL_MAILER=log
MAIL_FROM_ADDRESS="notifications@marketplace-mali.com"
MAIL_FROM_NAME="Marketplace Mali"

# ---------- SMS ----------
# log = écrit dans les journaux (aucun compte requis)
# orange = Orange SMS API (contrat developer.orange.com)
SMS_DRIVER=log
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_SENDER=Marketplace
